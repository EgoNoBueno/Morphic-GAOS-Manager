        {
          "dataset": "aos_logs",
          "project": "morphic-gaos-prod",
          "rawQuery": true,
          "rawSql": "SELECT COALESCE(\n  TIMESTAMP_DIFF(\n    CURRENT_TIMESTAMP(),\n    MIN(PARSE_TIMESTAMP('%Y-%m-%dT%H:%M:%E*S%Ez', timestamp)),\n    MINUTE\n  ),\n  0\n) AS oldest_pending_minutes\nFROM `morphic-gaos-prod.aos_logs.approval_history`\nWHERE status = 'pending'",
          "refId": "A",
          "location": "US"
        }
      ],
      "title": "Approval Queue — Oldest Age",
      "type": "stat"
    },
    {
