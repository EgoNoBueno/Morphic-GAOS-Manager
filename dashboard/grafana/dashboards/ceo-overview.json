      "targets": [
        {
          "dataset": "aos_logs",
          "project": "morphic-gaos-prod",
          "rawQuery": true,
          "rawSql": "SELECT COUNT(*) AS pending_count\nFROM `morphic-gaos-prod.aos_logs.approval_history`\nWHERE status = 'pending'",
          "refId": "A",
          "location": "US"
        }
      ],
      "title": "Approval Queue — Pending",
      "type": "stat"
    },
    {
      "datasource": { "type": "grafana-bigquery-datasource", "uid": "bigquery-morphic-gaos" },
