  "panels": [
    {
      "datasource": { "type": "grafana-bigquery-datasource", "uid": "bigquery-morphic-gaos" },
      "fieldConfig": {
        "defaults": {
          "custom": { "align": "auto", "displayMode": "auto", "inspect": false },
          "mappings": [
            {
              "type": "value",
              "options": {
                "IDLE":      { "color": "green",  "index": 0 },
                "WORKING":   { "color": "yellow", "index": 1 },
                "PARKED":    { "color": "orange", "index": 2 },
                "ESCALATED": { "color": "orange", "index": 3 },
                "ERROR":     { "color": "red",    "index": 4 }
              }
            }
          ],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "agent_id" },
            "properties": [
              { "id": "displayName", "value": "agent" },
              { "id": "custom.width", "value": 120 }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "status" },
            "properties": [
              { "id": "custom.displayMode", "value": "color-background" },
              { "id": "custom.width", "value": 110 }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "current_objective" },
            "properties": [
              { "id": "displayName", "value": "current objective" },
              { "id": "custom.width", "value": 300 }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "open_proposals" },
            "properties": [
              { "id": "displayName", "value": "open proposals" },
              { "id": "custom.width", "value": 110 }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "last_error" },
            "properties": [{ "id": "displayName", "value": "last error" }]
          },
          {
            "matcher": { "id": "byName", "options": "timestamp" },
            "properties": [{ "id": "custom.width", "value": 180 }]
          }
        ]
      },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 0 },
      "id": 1,
      "options": { "footer": { "enablePagination": false, "show": false }, "showHeader": true },
      "targets": [
        {
          "dataset": "aos_logs",
          "project": "morphic-gaos-prod",
          "rawQuery": true,
          "rawSql": "SELECT agent_id, status, current_objective, open_proposals, last_error, timestamp\nFROM (\n  SELECT *,\n    ROW_NUMBER() OVER (PARTITION BY agent_id ORDER BY timestamp DESC) AS rn\n  FROM `morphic-gaos-prod.aos_logs.status_snapshots`\n)\nWHERE rn = 1\nORDER BY agent_id",
          "refId": "A",
          "location": "US"
        }
      ],
      "title": "Agent Status",
      "type": "table"
    },
    {
      "datasource": { "type": "grafana-bigquery-datasource", "uid": "bigquery-morphic-gaos" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green",  "value": null },
              { "color": "yellow", "value": 3 },
