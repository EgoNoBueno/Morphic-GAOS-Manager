# Environment & secrets — never commit
.env
*.env
.env.*
!.env.example

# Settings — real config with project IDs must not be committed
config/settings.yaml

# Runtime logs — machine-specific, never commit
logs/

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
build/
dist/
*.egg-info/
.eggs/
*.egg
*.whl

# Virtual environments
.venv/
venv/
env/
ENV/

