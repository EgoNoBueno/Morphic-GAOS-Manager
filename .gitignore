.uv/
uv.lock

# IDE
.vscode/settings.json
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db
desktop.ini

# Credentials & keys (NEVER commit)
oauth-client.json
config/keys/
*.json
!pyproject.json
!dashboard/grafana/dashboards/*.json
service_account*.json
*_credentials.json
*_key.json

# Business-specific task agents — never commit to public repo
# Place your Tier 3 task agent implementations under agents/<domain>/tasks/
# The orchestrator.py files in agents/<domain>/ are public; tasks/ is private.
agents/*/tasks/

