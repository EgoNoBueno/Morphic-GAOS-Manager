# .dockerignore — excludes files from the Docker build context (COPY . .)
# Mirrors .gcloudignore — keep them in sync.

.env
*.env
.env.*

__pycache__/
*.py[cod]
*.pyo
*.pyd
build/
dist/
*.egg-info/
.eggs/
*.egg
*.whl

.venv/
venv/
env/
ENV/

.uv/
uv.lock

.vscode/
.idea/
*.swp
*.swo
*~

.DS_Store
Thumbs.db
desktop.ini

# Credentials & keys — NEVER in the image
oauth-client.json
config/keys/

agents/*/tasks/

.pytest_cache/
.coverage
htmlcov/
coverage.xml
.ruff_cache/
.mypy_cache/
PENDING_REPAIRS/
ACTIVE_SKILLS/
SKILLS_LOG.md
*.log
.ipynb_checkpoints/

.git/
